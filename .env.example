# Скопируй в .env и заполни. .env в git НЕ попадает (см. .gitignore).
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=appdb

APP_VERSION=dev
IMAGE=ghcr.io/OWNER/devops-lab:latest

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_too

# Домен для nginx/TLS. Если домена нет — оставь IP и работай по http.
APP_DOMAIN=example.com
